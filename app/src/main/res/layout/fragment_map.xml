<?xml version="1.0" encoding="utf-8"?>
<!--
    주유소 목록 화면 (지도 없음). 위에서부터 차례로 쌓는다: 진행 막대, 검색창과 필터 줄, 이득 1위 카드, 목록 머리줄, 목록.
    위치 권한 / 기기 위치 안내는 이득 1위 카드 자리에서 보여준다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/location_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/map_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_s">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_m"
            android:layout_marginBottom="@dimen/space_s"
            app:shapeAppearance="@style/ShapeAppearance.FindCheapGas.Pill">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_xs">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/search_mode_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/search_mode_place"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/search_mode_place"
                        style="@style/Widget.FindCheapGas.Button.SearchMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_mode_place" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/search_mode_station"
                        style="@style/Widget.FindCheapGas.Button.SearchMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_mode_station" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint_place"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <ImageButton
                    android:id="@+id/search_button"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_button"
                    android:src="@drawable/ic_search" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 검색한 장소·주유소, 지도 중심 기준으로 조회 중일 때만 보인다. X를 누르면 내 위치 기준으로 돌아간다. -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_origin"
                    style="@style/Widget.FindCheapGas.OriginChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s"
                    android:visibility="gone"
                    tools:text="강남역 기준"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fuel_type"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="휘발유" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_radius"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    tools:text="3km" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_brand"
                    style="@style/Widget.FindCheapGas.FilterDropdownChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    tools:text="브랜드" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 이득 1위 카드. 실제 예상 이득 1위를 보여주고, 목록에서 고른 주유소가 있으면 그 주유소로 바뀐다. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_m">

        <!--
            연료 부족 자동 제안. 다른 화면을 덮지 않고 이득 1위 카드 자리 위에 한 장으로 보여준다.
            주행 중에는 이 카드와 큰 버튼 두 개만 남기고 나머지는 숨긴다 (코드에서).
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/low_fuel_card"
            style="@style/Widget.FindCheapGas.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_m"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/low_fuel_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/low_fuel_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:minHeight="80dp"
                    android:textSize="24sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/low_fuel_later"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:minHeight="80dp"
                    android:text="@string/low_fuel_later"
                    android:textSize="24sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/best_card"
            style="@style/Widget.FindCheapGas.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_m">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 주유소를 보여줄 때의 본문 (세로 / 가로 화면 배치가 다름) -->
                <include layout="@layout/view_best_card_content" />

                <!-- 불러오는 중, 주유소 없음, 오류, 위치 권한·기기 위치 안내 -->
                <LinearLayout
                    android:id="@+id/best_card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/list_row_min_height_large"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/space_m"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/space_m"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/best_card_status_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_m"
                        android:indeterminate="true"
                        app:indicatorSize="@dimen/progress_size_small" />

                    <TextView
                        android:id="@+id/best_card_status_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="주변 주유소를 불러오고 있어요" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/best_card_status_button"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        tools:text="@string/station_retry" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 주행 중에만 보이는 큰 버튼. 누르면 경유지 승인 화면을 연다. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/driving_action_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:minHeight="88dp"
            android:text="@string/waypoint_action"
            android:textSize="26sp"
            android:visibility="gone" />

        <!-- 목록 머리줄: 왼쪽 "주변 23곳 · 내 위치 기준", 오른쪽 정렬 버튼 -->
        <LinearLayout
            android:id="@+id/station_list_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:id="@+id/station_sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="주변 23곳 · 내 위치 기준" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort"
                style="@style/Widget.FindCheapGas.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/space_s"
                android:paddingEnd="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="end"
                app:iconPadding="0dp"
                tools:text="예상 이득순" />
        </LinearLayout>

        <!-- 목록 카드. 시트를 올리면 이득 1위 카드 아래로 이어진다. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/station_list_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/station_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_s"
                tools:listitem="@layout/view_list_row_amount" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
