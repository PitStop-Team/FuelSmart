<?xml version="1.0" encoding="utf-8"?>
<!--
    경유지 추가 승인 화면. 주행 중에도 누르기 쉽도록 버튼을 크게 둔다.
    경로를 바꾸는 요청은 여기서 "경유지로 추가"를 눌렀을 때만 내비게이션에 보낸다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <TextView
        android:id="@+id/approval_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/waypoint_approval_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:id="@+id/approval_station"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:id="@+id/approval_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/approval_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:minHeight="72dp"
        android:text="@string/waypoint_approve"
        android:textSize="22sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/approval_cancel"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:minHeight="72dp"
        android:text="@string/waypoint_cancel"
        android:textSize="22sp" />
</LinearLayout>
